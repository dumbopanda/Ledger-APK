<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- §8 — the whole permission list, every entry justified. Notably
         absent: POST_NOTIFICATIONS and USE_BIOMETRIC, both runtime-only
         and requested in-context by features that don't exist yet
         (backup reminder, app lock) — adding them to the manifest early
         wouldn't grant anything ahead of schedule, so they're deferred
         to whichever block actually builds those features. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".LedgerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager is configured manually in LedgerApplication (via
             Configuration.Provider + HiltWorkerFactory) so @HiltWorker
             classes like SyncWorker can be constructed; its default
             androidx.startup auto-init would build workers with no DI. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
